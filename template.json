{
  "kind": "template",
  "apiVersion": 2,
  "id": "urano-acid",
  "name": "Urano Acid · Cyber-Brutalist",
  "version": "1.0.0",
  "description": "Estética Cyber-Brutalist de alto impacto: negro puro, verde ácido neón, tipografía monospace y arquitectura SDK 2. MIT · ES/EN.",
  "font": {
    "file": "fonts/GeistMono.woff2"
  },
  "theme": {
    "light": {
      "background": "0 0% 100%",
      "foreground": "0 0% 0%",
      "card": "0 0% 98%",
      "card-foreground": "0 0% 0%",
      "popover": "0 0% 100%",
      "popover-foreground": "0 0% 0%",
      "primary": "82 100% 42%",
      "primary-foreground": "0 0% 0%",
      "secondary": "0 0% 93%",
      "secondary-foreground": "0 0% 0%",
      "muted": "0 0% 94%",
      "muted-foreground": "0 0% 40%",
      "accent": "82 100% 45%",
      "accent-foreground": "0 0% 0%",
      "border": "0 0% 15%",
      "input": "0 0% 20%",
      "ring": "82 100% 40%",
      "sidebar-background": "0 0% 97%",
      "sidebar-foreground": "0 0% 5%",
      "sidebar-primary": "82 100% 40%",
      "sidebar-primary-foreground": "0 0% 0%",
      "sidebar-accent": "82 80% 92%",
      "sidebar-accent-foreground": "0 0% 0%",
      "sidebar-border": "0 0% 15%",
      "sidebar-ring": "82 100% 40%"
    },
    "dark": {
      "background": "0 0% 4%",
      "foreground": "0 0% 100%",
      "card": "0 0% 6%",
      "card-foreground": "0 0% 100%",
      "popover": "0 0% 7%",
      "popover-foreground": "0 0% 100%",
      "primary": "82 100% 50%",
      "primary-foreground": "0 0% 4%",
      "secondary": "80 15% 12%",
      "secondary-foreground": "0 0% 95%",
      "muted": "0 0% 12%",
      "muted-foreground": "0 0% 65%",
      "accent": "82 100% 50%",
      "accent-foreground": "0 0% 4%",
      "border": "0 0% 20%",
      "input": "0 0% 22%",
      "ring": "82 100% 50%",
      "sidebar-background": "0 0% 2%",
      "sidebar-foreground": "0 0% 96%",
      "sidebar-primary": "82 100% 50%",
      "sidebar-primary-foreground": "0 0% 4%",
      "sidebar-accent": "82 100% 12%",
      "sidebar-accent-foreground": "82 100% 55%",
      "sidebar-border": "0 0% 18%",
      "sidebar-ring": "82 100% 50%"
    }
  },
  "layout": {
    "direction": "row",
    "children": [
      {
        "slot": "sidebar"
      },
      {
        "direction": "column",
        "children": [
          {
            "slot": "header"
          },
          {
            "slot": "subheader"
          },
          {
            "direction": "row",
            "children": [
              {
                "slot": "content"
              },
              {
                "slot": "assistant"
              }
            ]
          }
        ]
      }
    ]
  },
  "surfaces": {
    "navigation": "studio",
    "header": "studio",
    "chat": "studio"
  },
  "components": {
    "navigation": "acid-navigation",
    "header": "acid-header",
    "history": "acid-history",
    "welcome": "acid-welcome"
  },
  "loading": {
    "label": "Inicializando protocolo ACID // RAW",
    "labelEn": "Initializing ACID // RAW protocol"
  },
  "views": [
    {
      "id": "acid-navigation",
      "title": "Acid · Navegación",
      "bundle": "ui/bundle.js",
      "capabilities": [
        "appearance.read",
        "surface.read",
        "surface.act"
      ]
    },
    {
      "id": "acid-header",
      "title": "Acid · Cabecera",
      "bundle": "ui/bundle.js",
      "capabilities": [
        "appearance.read",
        "surface.read",
        "surface.act"
      ]
    },
    {
      "id": "acid-history",
      "title": "Acid · Historial",
      "bundle": "ui/bundle.js",
      "capabilities": [
        "appearance.read",
        "surface.read",
        "surface.act"
      ]
    },
    {
      "id": "acid-welcome",
      "title": "Acid · Bienvenida",
      "bundle": "ui/bundle.js",
      "capabilities": [
        "appearance.read",
        "surface.read",
        "surface.act"
      ]
    },
    {
      "id": "acid-forge",
      "title": "Acid · Prompt Forge",
      "bundle": "ui/bundle.js",
      "capabilities": [
        "appearance.read",
        "navigation.open"
      ]
    }
  ],
  "presentation": {
    "scrollbars": "native",
    "userBubble": "brutalist",
    "composer": "terminal"
  }
}
